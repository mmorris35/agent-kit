[Unit]
Description=Nellie — local code memory for Claude Code
Documentation=https://github.com/mmorris35/nellie
After=network.target

[Service]
Type=simple
# Bind address comes from setup.sh --bind. The default, 127.0.0.1, means this
# machine only. Anything wider is reachable by whatever can route to it, and
# Nellie has no authentication of its own.
ExecStart=__NELLIE_BIN__ serve \
    --host __BIND__ \
    --port __PORT__ \
    --data-dir __DATA_DIR__ \
    --watch __WATCH_DIR__ \
    --enable-graph \
    --enable-structural \
    --enable-deep-hooks \
    --sync-interval 30
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
