{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "AskUserQuestion",
      "Bash(sudo:*)",
      "Bash(reboot:*)",
      "Bash(shutdown:*)",
      "Bash(rm -rf /:*)",
      "Read(~/.claude/channels/telegram/.env)",
      "Read(~/.ssh/**)"
    ]
  },
  "enabledPlugins": {
    "telegram@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true
}
